---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { skillCategories } from '../../../data/skills_en';

---

<BaseLayout
  title="Skills — pwnVader"
  description="pwnVader's technical skills organized by category: Offensive Security, Systems & Networks, AI & Automation, Power Platform, and CTFs."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-20">
    <!-- Hacking Skills Section -->
    <header class="mb-8 animate-fade-up">
      <h2 class="font-mono text-sm mb-4">
        <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/skills</span><span class="text-text-muted">$</span>
        <span class="ml-2 text-slate-100">cat /proc/skills | sort --category</span>
      </h2>
    </header>

    <!-- Skills Grid -->
    <div class="grid gap-5 md:grid-cols-2">
      {skillCategories.map((category, catIdx) => (
        <div
          class={`animate-fade-up bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 hover:bg-slate-800/40 hover:border-slate-600/50 overflow-hidden transition-all duration-300 transform hover:-translate-y-1 hover:-translate-x-1 ${category.hoverClass}`}
          style={`animation-delay: ${catIdx * 100}ms;`}
        >
          <!-- Category header -->
          <div class="flex items-center gap-3 px-5 py-3 border-b border-border bg-bg-elevated/50">
            <Icon name={category.icon} class={`w-5 h-5 ${category.colorClass}`} />
            <h2 class="font-mono text-sm font-bold text-text-primary">
              {category.title}
            </h2>
          </div>

          <!-- Terminal command -->
          <div class="px-5 pt-3 pb-1">
            <p class="font-mono text-xs text-text-muted">
              <span class={`${category.colorClass} opacity-70`}>$</span> {category.command}
            </p>
          </div>

          <!-- Skills list -->
          <ul class="px-5 pb-4 space-y-1.5">
            {category.skills.map((skill) => (
              <li class="flex items-center justify-between gap-3 font-mono text-sm">
                <span class="text-text-secondary flex items-center gap-2">
                  {skill.icon ? (
                    <Icon name={skill.icon} class="w-3.5 h-3.5 opacity-90" />
                  ) : (
                    <span class={`text-[10px] pl-[1px] ${category.colorClass} opacity-70`}>▸</span>
                  )}
                  {skill.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
