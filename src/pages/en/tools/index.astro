---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Tools — pwnVader"
  description="Suite de herramientas ofensivas desarrolladas por pwnVader en hacking.pwnvader.com"
>
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-20">

    <!-- Page header -->
    <header class="mb-8 animate-fade-up">
      <h2 class="font-mono text-sm mb-4">
        <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/tools</span><span class="text-text-muted">$</span>
        <span class="ml-2 text-slate-100">curl -s hacking.pwnvader.com/api/tools | jq '.'</span>
      </h2>
    </header>

    <!-- Prominent Subdomain CTA (Top-level) -->
    <div class="mb-10 animate-fade-up" style="animation-delay: 100ms;">
      <div class="relative bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 p-6 sm:p-8 text-center transition-all duration-300 hover:bg-slate-800/40 hover:border-slate-600/50">
        
        <!-- Blinking operational badge -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 flex items-center gap-2 px-2.5 py-1 text-slate-500 font-mono text-[9px] sm:text-[10px] uppercase tracking-wider font-semibold">
          [ LIVE LAB ]
        </div>

        <div class="flex flex-col items-center">
          <p class="font-mono text-xs text-text-muted mb-3 flex items-center gap-1.5">
            <span class="text-slate-400">$</span> xdg-open https://hacking.pwnvader.com
          </p>

          <h2 class="text-text-primary text-base sm:text-lg md:text-xl font-bold leading-relaxed font-mono max-w-2xl mt-1 mb-6">
            Explora la suite completa y corre auditorías directas desde tu navegador en
            <a 
              href="https://hacking.pwnvader.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 font-bold underline decoration-2 underline-offset-4 hover:text-[#f9e2af] transition-colors"
            >
              hacking.pwnvader.com
            </a>
          </h2>

          <a
            href="https://hacking.pwnvader.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 font-mono text-sm sm:text-base font-bold bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 text-slate-400 transition-all duration-300 hover:bg-slate-800/40 hover:border-slate-600/50 transform cursor-pointer"
          >
            <Icon name="lucide:shield-check" class="w-5 h-5 animate-pulse" />
            Acceder al Laboratorio
          </a>
        </div>
      </div>
    </div>

    <hr class="border-t border-slate-800/60 my-14" />

    <!-- Available Tools -->
    <div class="animate-fade-up" style="animation-delay: 300ms;">
      <h2 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-4">
        <span class="text-slate-400">#</span> cat available_tools.txt
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          {
            icon: 'lucide:network',
            label: 'Networking / RevShell',
            desc: 'Calculadora de subnetting IPv4 interactiva y generador de reverse shells multi-lenguaje con encoding.',
            color: 'text-slate-400',
            border: 'border-[#89b4fa]/20 hover:border-[#89b4fa]/50 hover:shadow-[0_0_15px_rgba(137,180,250,0.1)]',
            href: 'https://hacking.pwnvader.com/networking'
          },
          {
            icon: 'lucide:shield-alert',
            label: 'CMS Audit',
            desc: 'Auditoría pasiva de seguridad para WordPress: chequeo de cabeceras, enumeración de usuarios y endpoints expuestos.',
            color: 'text-slate-400',
            border: 'border-[#cba6f7]/20 hover:border-[#cba6f7]/50 hover:shadow-[0_0_15px_rgba(203,166,247,0.1)]',
            href: 'https://hacking.pwnvader.com/cms'
          },
          {
            icon: 'lucide:sparkles',
            label: 'Encoders / Stegano',
            desc: 'Codificaciones (Base64, URL, Hex, ROT) y esteganografía especial para ocultar texto invisible dentro de emojis.',
            color: 'text-slate-400',
            border: 'border-[#f38ba8]/20 hover:border-[#f38ba8]/50 hover:shadow-[0_0_15px_rgba(243,139,168,0.1)]',
            href: 'https://hacking.pwnvader.com/encoders'
          },
        ].map(item => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 p-4 transition-all duration-300 transform hover:bg-slate-800/40 hover:border-slate-600/50 block"
          >
            <div class="flex items-center justify-between mb-3">
              <Icon name={item.icon} class={`w-5 h-5 ${item.color} transition-transform group-hover:scale-110`} />
              <Icon name="lucide:arrow-up-right" class="w-4 h-4 text-text-muted/60 opacity-0 group-hover:opacity-100 transition-all transform translate-x-1 -translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0" />
            </div>
            <p class={`font-mono text-sm font-bold ${item.color} group-hover:text-text-primary transition-colors`}>{item.label}</p>
            <p class="font-mono text-xs text-text-muted mt-2 leading-relaxed">{item.desc}</p>
            <span class="inline-block mt-4 font-mono text-[10px] text-slate-500">
              [ ONLINE ]
            </span>
          </a>
        ))}
      </div>
    </div>

    <hr class="border-t border-slate-800/60 my-14" />

    <!-- Terminal with build progress (Deployment log) -->
    <div class="animate-fade-up" style="animation-delay: 400ms;">
      <h2 class="font-mono text-sm mb-4">
        <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/tools</span><span class="text-text-muted">$</span>
        <span class="ml-2 text-slate-100">tail -n 25 deploy.log</span>
      </h2>
      <div class="bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 hover:bg-slate-800/40 hover:border-slate-600/50 transition-all duration-300">

        <!-- Terminal body -->
        <div class="p-4 sm:p-6 font-mono text-xs sm:text-sm space-y-2 leading-relaxed">
          <p>
            <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/tools</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-primary">git clone https://github.com/pwnvader/tools.git</span>
          </p>
          <p class="text-text-muted pl-4">Cloning into 'tools'...</p>
          <p class="text-text-muted pl-4">remote: Enumerating objects: <span class="text-[#f9e2af]">∞</span>, done.</p>

          <div class="h-1"></div>

          <p>
            <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/tools</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-primary">make build</span>
          </p>
          <p class="text-text-muted pl-4">[<span class="text-slate-400">  0%</span>] Compiling offensive toolkit...</p>
          <p class="text-text-muted pl-4">[<span class="text-[#f9e2af]"> 33%</span>] Integrating security modules...</p>
          <p class="text-text-muted pl-4">[<span class="text-slate-400"> 66%</span>] Testing in controlled environments...</p>
          <p class="text-slate-400 pl-4">[<span class="text-slate-400">100%</span>] Toolkit compiled successfully!</p>

          <div class="h-1"></div>

          <!-- Progress bar -->
          <div class="flex items-center gap-3">
            <span class="text-text-muted">[</span>
            <div class="flex-1 h-1.5 bg-bg-elevated rounded-full overflow-hidden">
              <div class="h-full w-full bg-[#a6e3a1] rounded-full shadow-[0_0_10px_rgba(166,227,161,0.5)]"></div>
            </div>
            <span class="text-text-muted">]</span>
            <span class="text-slate-400 text-xs">100%</span>
          </div>

          <div class="h-1"></div>

          <p class="text-slate-400 font-bold">
            [SUCCESS] Offensive tools successfully deployed to hacking.pwnvader.com
          </p>

          <p>
            <span class="text-slate-400">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-slate-400">~/tools</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-muted animate-pulse">█</span>
          </p>
        </div>
      </div>
    </div>

  </section>
</BaseLayout>
