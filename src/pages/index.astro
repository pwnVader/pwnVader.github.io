---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import SocialLinks from '../components/SocialLinks.astro';
import StatsGrid from '../components/StatsGrid.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="pwnVader — Pentester · eJPTv2 · COAE">
  <section class="relative mx-auto max-w-4xl px-4 pt-16 pb-20">
    <!-- Ambient Glare -->
    <div class="absolute inset-x-0 -top-10 h-[400px] w-full max-w-2xl mx-auto bg-[radial-gradient(ellipse_at_top,_var(--color-accent)_0%,_transparent_60%)] opacity-[0.07] pointer-events-none blur-[80px]"></div>

    <!-- Hero Terminal -->
    <div class="relative animate-fade-up">
      <Terminal title="pwnvader@kali — bash">
        <div class="space-y-1.5">
          <!-- cat readme.txt command -->
          <p>
            <span class="text-[#a6e3a1]">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-[#89b4fa]">~</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-primary">cat readme.txt</span>
          </p>

          <div class="h-2"></div>

          <!-- Identity block -->
          <div class="space-y-0.5">
            <p class="text-2xl sm:text-3xl font-bold text-text-primary leading-tight">
              Jesus P Romero
            </p>
            <p class="text-lg sm:text-xl font-bold text-[#cba6f7]">
              pwnVader
            </p>
          </div>

          <div class="h-2"></div>

          <!-- Tagline — IDE syntax pills. Cert tags wear their grid identity at rest. -->
          <div class="flex flex-wrap items-center gap-2">
            {[
              { label: 'COAE', iconImg: '/images/certs/coae.webp', tone: 'text-[#cba6f7] border-[#cba6f7]/30', href: 'https://academy.hackthebox.com/achievement/badge/847979fe-4aca-11f1-82d1-bea50ffe6cb4' },
              { label: 'eJPTv2', icon: 'cert-ejpt', tone: 'text-[#f5c2e7] border-[#f5c2e7]/30', href: 'https://certs.ine.com/a3d19feb-3d6e-4102-ba75-75e6013bfeee#acc.SaZlAfnt' },
              { label: 'Pentester', tone: 'text-[#f38ba8]/90 border-[#f38ba8]/25' },
              { label: 'Ing. Sistemas Computacionales', tone: 'text-[#89b4fa]/90 border-[#89b4fa]/25' },
            ].map((tag) => {
              const tagClass = `flex items-center gap-1.5 text-xs px-2.5 py-1 rounded border bg-bg-surface ${tag.tone}`;
              return tag.href ? (
                <a href={tag.href} target="_blank" rel="noopener noreferrer" class={`${tagClass} transition-colors hover:brightness-110`}>
                  {tag.iconImg ? (
                    <img src={tag.iconImg} alt="" class="w-4 h-4 object-contain" />
                  ) : tag.icon ? (
                    <Icon name={tag.icon} class="w-4 h-4" />
                  ) : null}
                  {tag.label}
                </a>
              ) : (
                <span class={tagClass}>
                  {tag.iconImg ? (
                    <img src={tag.iconImg} alt="" class="w-4 h-4 object-contain" />
                  ) : tag.icon ? (
                    <Icon name={tag.icon} class="w-4 h-4" />
                  ) : null}
                  {tag.label}
                </span>
              );
            })}
          </div>

          <div class="h-2"></div>

          <!-- Bio -->
          <p class="text-text-secondary text-sm leading-relaxed max-w-xl">
            Pentester especializado en <span class="text-[#f38ba8]">seguridad ofensiva</span>, mentoría técnica en
            comunidades como <span class="text-[#94e2d5]">NicaSecurity</span> y ponente en <span class="text-[#94e2d5]">NetSentinel Academy</span> sobre
            <span class="text-[#fab387]">IA aplicada a la ciberseguridad</span>. Certificado <span class="text-[#cba6f7]">COAE</span> y <span class="text-[#f5c2e7]">eJPTv2</span>. Próximo objetivo: <span class="text-[#f9e2af]">CPTS</span>.
          </p>

          <div class="h-4"></div>

          <!-- Timeline / Experience -->
          <ul class="border-l border-border/60 ml-[5px] space-y-4 pt-1 pb-3">
            {[
              { date: 'Mar 2026', title: 'Technical Clinics: Road to eJPT: Lab Series' },
              { date: 'Ene 2026', title: 'Workshop Agentic Workflow: Tu Primer Entorno de Pentest con IA y MCP' },
              { date: 'Dic 2025', title: 'Internship Automatización y digitalización de auditoría de producto', org: 'Volkswagen' },
              { date: 'Nov 2025', title: 'Mentor de Ciberseguridad' },
            ].map(exp => (
              <li class="relative pl-4">
                <span class="absolute -left-[4.5px] top-1.5 w-2 h-2 rounded-full border border-accent/40 bg-accent/20"></span>
                <p class="font-mono text-[10px] text-[#a6e3a1]">{exp.date}</p>
                <p class="text-sm mt-0.5 leading-snug">
                  <span class="text-text-primary">{exp.title}</span>
                  {exp.org && (
                    <span class="text-text-muted mt-0.5 block sm:inline sm:ml-1">— {exp.org}</span>
                  )}
                </p>
              </li>
            ))}
          </ul>

          <div class="h-3"></div>

          <!-- Prompt cursor -->
          <p class="flex items-center gap-1">
            <span class="text-[#a6e3a1]">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-[#89b4fa]">~</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-muted animate-pulse">█</span>
          </p>
        </div>
      </Terminal>
    </div>

    <!-- CTA Buttons — Monochrome with ember interaction accent -->
    <div class="mt-10 flex flex-wrap gap-3 animate-fade-up" style="animation-delay: 150ms;">
      <a
        href="/skills/"
        class="rounded-lg border border-border bg-bg-surface px-6 py-2.5 font-mono text-sm text-text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
      >
        ./skills.sh
      </a>
      <a
        href="/writeups/"
        class="rounded-lg border border-border bg-bg-surface px-6 py-2.5 font-mono text-sm text-text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
      >
        ls writeups/
      </a>
      <a
        href="/linkedin/"
        class="rounded-lg border border-border bg-bg-surface px-6 py-2.5 font-mono text-sm text-text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
      >
        cat community.txt
      </a>
    </div>

    <!-- Social Links Section -->
    <div class="mt-12 animate-fade-up" style="animation-delay: 300ms;">
      <h2 class="font-mono text-sm text-text-muted mb-4">
        <span class="text-accent">$</span> cat social_links.txt
      </h2>
      <SocialLinks />
    </div>

    <!-- Quick Stats — Glowing Reactive Dashboard -->
    <div class="mt-12 animate-fade-up" style="animation-delay: 450ms;">
      <StatsGrid />
    </div>
  </section>
</BaseLayout>
