---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import SocialFastfetch from '../components/SocialFastfetch.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="pwnVader — Pentester · eJPTv2 · COAE">
  <section class="relative mx-auto max-w-4xl px-4 pt-16 pb-20">
    <!-- Ambient Glare -->
    <div class="absolute inset-x-0 -top-10 h-[400px] w-full max-w-2xl mx-auto bg-[radial-gradient(ellipse_at_top,_var(--color-accent)_0%,_transparent_60%)] opacity-[0.07] pointer-events-none blur-[80px]"></div>

    <!-- Hero Terminal -->
    <div class="relative animate-fade-up">
      <Terminal title="pwnvader@kali — bash">
        <div class="space-y-1.5">
          <!-- cat readme.txt command -->
          <p>
            <span class="text-[#a6e3a1]">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-[#89b4fa]">~</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-primary">cat readme.txt</span>
          </p>

          <div class="h-2"></div>

          <!-- Identity block -->
          <div class="space-y-0.5">
            <p class="text-2xl sm:text-3xl font-bold text-text-primary leading-tight">
              Jesus P Romero
            </p>
            <p class="text-lg sm:text-xl font-bold text-[#cba6f7]">
              pwnVader
            </p>
          </div>

          <div class="h-2"></div>

          <!-- Tagline — IDE syntax pills. Cert tags wear their grid identity at rest. -->
          <div class="flex flex-wrap items-center gap-2">
            {[
              { label: 'COAE', iconImg: '/images/certs/coae.webp', tone: 'text-[#cba6f7] border-[#cba6f7]/30', href: 'https://academy.hackthebox.com/achievement/badge/847979fe-4aca-11f1-82d1-bea50ffe6cb4' },
              { label: 'eJPTv2', icon: 'cert-ejpt', tone: 'text-[#f5c2e7] border-[#f5c2e7]/30', href: 'https://certs.ine.com/a3d19feb-3d6e-4102-ba75-75e6013bfeee#acc.SaZlAfnt' },
              { label: 'Pentester', tone: 'text-[#f38ba8]/90 border-[#f38ba8]/25' },
              { label: 'Ing. Sistemas Computacionales', tone: 'text-[#89b4fa]/90 border-[#89b4fa]/25' },
            ].map((tag) => {
              const tagClass = `flex items-center gap-1.5 text-xs px-2.5 py-1 rounded border bg-bg-surface ${tag.tone}`;
              return tag.href ? (
                <a href={tag.href} target="_blank" rel="noopener noreferrer" class={`${tagClass} transition-colors hover:brightness-110`}>
                  {tag.iconImg ? (
                    <img src={tag.iconImg} alt="" class="w-4 h-4 object-contain" />
                  ) : tag.icon ? (
                    <Icon name={tag.icon} class="w-4 h-4" />
                  ) : null}
                  {tag.label}
                </a>
              ) : (
                <span class={tagClass}>
                  {tag.iconImg ? (
                    <img src={tag.iconImg} alt="" class="w-4 h-4 object-contain" />
                  ) : tag.icon ? (
                    <Icon name={tag.icon} class="w-4 h-4" />
                  ) : null}
                  {tag.label}
                </span>
              );
            })}
          </div>

          <div class="h-2"></div>

          <!-- Bio — snapshot only; full story vive en /about -->
          <div class="text-text-secondary text-sm leading-relaxed max-w-xl space-y-2">
            <p>
              Pentester especializado en <span class="text-[#f38ba8]">seguridad ofensiva</span>: redes,
              aplicaciones web y <span class="text-[#89b4fa]">Active Directory</span>.
            </p>
            <p>
              Entrenamiento continuo en <span class="text-[#a6e3a1]">plataformas de hacking</span> y
              <span class="text-[#94e2d5]">laboratorios técnicos</span>.
            </p>
          </div>

          <div class="h-3"></div>

          <!-- Hint to deeper page -->
          <p class="font-mono text-xs text-text-muted">
            <span class="text-text-muted">→</span> <a href="/about/" class="text-accent hover:underline">cat /etc/pwnvader/profile.conf</a> para detalle completo
          </p>

          <div class="h-3"></div>

          <!-- Prompt cursor -->
          <p class="flex items-center gap-1">
            <span class="text-[#a6e3a1]">pwnvader@kali</span><span class="text-text-muted">:</span><span class="text-[#89b4fa]">~</span><span class="text-text-muted">$</span>
            <span class="ml-2 text-text-muted animate-pulse">█</span>
          </p>
        </div>
      </Terminal>
    </div>

    <!-- Fastfetch — Kali ASCII + socials info (collapsible) -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 200ms;">
      <SocialFastfetch />
    </div>

    <!-- Ecosistema pwnVader — consolidated web assets card -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 250ms;">
      <h2 class="font-mono text-sm text-text-muted mb-4">
        <span class="text-accent">$</span> cat ecosystem.json
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Portfolio card -->
        <a 
          href="/" 
          class="group relative overflow-hidden rounded-lg border border-[#89b4fa]/20 bg-bg-surface p-4 transition-all duration-300 transform hover:-translate-y-1 hover:border-[#89b4fa]/50 hover:shadow-[0_0_15px_rgba(137,180,250,0.1)] block"
        >
          <div class="flex items-center justify-between mb-3">
            <Icon name="lucide:terminal" class="w-5 h-5 text-[#89b4fa]" />
            <span class="text-[9px] sm:text-[10px] text-[#cba6f7] border border-[#cba6f7]/30 bg-[#cba6f7]/5 px-2 py-0.5 rounded font-mono uppercase font-bold select-none">active</span>
          </div>
          <p class="font-mono text-sm font-bold text-[#89b4fa] group-hover:text-text-primary transition-colors">pwnvader.com</p>
          <p class="font-mono text-xs text-text-secondary mt-1 font-semibold">Portfolio Principal</p>
          <p class="font-mono text-[11px] text-text-muted mt-2 leading-relaxed">Presentación profesional, certificaciones, trayectoria y contacto ejecutivo.</p>
        </a>

        <!-- Lab card -->
        <a 
          href="https://hacking.pwnvader.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group relative overflow-hidden rounded-lg border border-border bg-bg-surface p-4 transition-all duration-300 transform hover:-translate-y-1 hover:border-[#fab387]/50 hover:shadow-[0_0_15px_rgba(250,179,135,0.1)] block"
        >
          <div class="flex items-center justify-between mb-3">
            <Icon name="lucide:shield-check" class="w-5 h-5 text-[#fab387]" />
            <span class="text-[9px] sm:text-[10px] text-zinc-500 border border-zinc-700 bg-zinc-800/10 px-2 py-0.5 rounded font-mono uppercase select-none">external</span>
          </div>
          <p class="font-mono text-sm font-bold text-[#fab387] group-hover:text-text-primary transition-colors font-semibold">hacking.pwnvader.com</p>
          <p class="font-mono text-xs text-text-secondary mt-1 font-semibold">Laboratorio Táctico</p>
          <p class="font-mono text-[11px] text-text-muted mt-2 leading-relaxed">Suite de herramientas ofensivas (RevShells, subnetting, encoders, auditorías de CMS).</p>
        </a>

        <!-- Docs card -->
        <a 
          href="https://docs.pwnvader.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group relative overflow-hidden rounded-lg border border-border bg-bg-surface p-4 transition-all duration-300 transform hover:-translate-y-1 hover:border-[#cba6f7]/50 hover:shadow-[0_0_15px_rgba(203,166,247,0.1)] block"
        >
          <div class="flex items-center justify-between mb-3">
            <Icon name="lucide:book-open" class="w-5 h-5 text-[#cba6f7]" />
            <span class="text-[9px] sm:text-[10px] text-zinc-500 border border-zinc-700 bg-zinc-800/10 px-2 py-0.5 rounded font-mono uppercase select-none">external</span>
          </div>
          <p class="font-mono text-sm font-bold text-[#cba6f7] group-hover:text-text-primary transition-colors font-semibold">docs.pwnvader.com</p>
          <p class="font-mono text-xs text-text-secondary mt-1 font-semibold">Writeups & Docs</p>
          <p class="font-mono text-[11px] text-text-muted mt-2 leading-relaxed">Metodologías, cheatsheets y guías detalladas de explotación de máquinas (HTB, THM).</p>
        </a>
      </div>
    </div>

    <!-- Social Links Section — functional click-through cards -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 300ms;">
      <h2 class="font-mono text-sm text-text-muted mb-4">
        <span class="text-accent">$</span> cat social_links.txt
      </h2>
      <SocialLinks />
    </div>
  </section>
</BaseLayout>
