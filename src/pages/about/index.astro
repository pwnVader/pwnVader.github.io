---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const certifications = [
  {
    name: 'COAE',
    fullName: 'Certified Offensive AI Expert',
    org: 'Hack The Box',
    date: 'May 2026',
    color: 'text-[#cba6f7]',
    borderColor: 'border-[#cba6f7]/30',
    glowColor: 'hover:shadow-[0_0_18px_rgba(203,166,247,0.15)]',
    href: 'https://academy.hackthebox.com/achievement/badge/847979fe-4aca-11f1-82d1-bea50ffe6cb4',
    iconImg: '/images/certs/coae.webp',
  },
  {
    name: 'eJPTv2',
    fullName: 'eLearnSecurity Junior Penetration Tester',
    org: 'INE Security',
    date: '2025',
    color: 'text-[#f5c2e7]',
    borderColor: 'border-[#f5c2e7]/30',
    glowColor: 'hover:shadow-[0_0_18px_rgba(245,194,231,0.15)]',
    href: 'https://certs.ine.com/a3d19feb-3d6e-4102-ba75-75e6013bfeee#acc.SaZlAfnt',
    icon: 'cert-ejpt',
  },
];

const typeIcon = {
  cert: 'lucide:award',
  speaker: 'lucide:mic',
  work: 'lucide:briefcase',
  mentor: 'lucide:users',
};

const typeLabel = {
  cert: 'CERT',
  speaker: 'TALK',
  work: 'WORK',
  mentor: 'MENTOR',
};

const timeline = [
  {
    date: 'May 2026',
    title: 'Certified Offensive AI Expert (COAE)',
    type: 'cert',
    color: 'text-[#cba6f7]',
    borderHover: 'hover:border-[#cba6f7]/40',
    dotBg: 'bg-[#cba6f7]/15 border-[#cba6f7]/40',
  },
  {
    date: 'Mar 2026',
    title: 'Technical Clinics: Road to eJPT — Lab Series',
    subtitle: 'Instructor · NicaSecurity',
    type: 'speaker',
    color: 'text-[#94e2d5]',
    borderHover: 'hover:border-[#94e2d5]/40',
    dotBg: 'bg-[#94e2d5]/15 border-[#94e2d5]/40',
  },
  {
    date: 'Ene 2026',
    title: 'Workshop Agentic Workflow: Pentest con IA y MCP',
    subtitle: 'Ponente · NetSentinel Academy',
    type: 'speaker',
    color: 'text-[#fab387]',
    borderHover: 'hover:border-[#fab387]/40',
    dotBg: 'bg-[#fab387]/15 border-[#fab387]/40',
  },
  {
    date: 'Dic 2025',
    title: 'Internship — Automatización de auditoría',
    subtitle: 'Volkswagen Group',
    type: 'work',
    color: 'text-[#89b4fa]',
    borderHover: 'hover:border-[#89b4fa]/40',
    dotBg: 'bg-[#89b4fa]/15 border-[#89b4fa]/40',
  },
  {
    date: 'Nov 2025',
    title: 'Mentor de Ciberseguridad',
    subtitle: 'Nación Hacker',
    type: 'mentor',
    color: 'text-[#a6e3a1]',
    borderHover: 'hover:border-[#a6e3a1]/40',
    dotBg: 'bg-[#a6e3a1]/15 border-[#a6e3a1]/40',
  },
  {
    date: '2025',
    title: 'eJPTv2 Certified',
    type: 'cert',
    color: 'text-[#f5c2e7]',
    borderHover: 'hover:border-[#f5c2e7]/40',
    dotBg: 'bg-[#f5c2e7]/15 border-[#f5c2e7]/40',
  },
];
---

<BaseLayout
  title="About — pwnVader"
  description="Conoce a Jesus P Romero (pwnVader) — Pentester certificado COAE y eJPTv2, speaker, mentor y creador de contenido en ciberseguridad."
>
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-20">
    <!-- Page header -->
    <header class="mb-12 animate-fade-up">
      <h1 class="font-mono text-2xl sm:text-3xl font-bold text-text-primary">
        <span class="text-[#89b4fa]">~/</span>about
      </h1>
      <p class="mt-2 font-mono text-sm text-text-secondary">
        <span class="text-[#a6e3a1]">$</span> cat /etc/pwnvader/profile.conf
      </p>
    </header>

    <!-- Bio Section -->
    <div class="animate-fade-up space-y-6" style="animation-delay: 100ms;">
      <div class="rounded-lg border border-border bg-bg-surface p-6 sm:p-8">
        <div class="space-y-4">
          <div>
            <h2 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-3">
              <span class="text-[#a6e3a1]">#</span> whoami
            </h2>
            <p class="text-text-secondary text-sm leading-relaxed">
              Soy <span class="text-text-primary font-medium">Jesus Perez Romero</span>. Pentester enfocado en
              <span class="text-[#f38ba8]">seguridad ofensiva</span>.
            </p>
          </div>

          <p class="text-text-secondary text-sm leading-relaxed">
            Actualmente curso mi último año de
            <span class="text-[#89b4fa]">Ingeniería en Sistemas Computacionales</span>.
          </p>

          <p class="text-text-secondary text-sm leading-relaxed">
            Fuera del pentesting, imparto talleres en
            <span class="text-[#94e2d5]">NicaSecurity</span> y
            <span class="text-[#94e2d5]">NetSentinel Academy</span> sobre
            <span class="text-[#fab387]">pentest con IA</span>, así como laboratorios técnicos guiados para la
            preparación de certificaciones como la <span class="text-[#f5c2e7]">eJPTv2</span>.
          </p>

          <p class="text-text-secondary text-sm leading-relaxed">
            En paralelo, mantengo una presencia activa en
            <span class="text-[#74c7ec]">LinkedIn</span>, donde desgloso y comparto conceptos técnicos de
            <span class="text-[#f38ba8]">seguridad ofensiva</span> para aportar valor y fortalecer a la
            <span class="text-[#a6e3a1]">comunidad de ciberseguridad</span>.
          </p>
        </div>
      </div>
    </div>

    <!-- Certifications -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 200ms;">
      <h2 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-4">
        <span class="text-[#a6e3a1]">#</span> certifications --verified
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {certifications.map((cert) => (
          <a
            href={cert.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`group flex items-center gap-4 rounded-lg border ${cert.borderColor} bg-bg-surface p-5 transition-all duration-300 hover:-translate-y-0.5 ${cert.glowColor}`}
          >
            <div class="shrink-0">
              {cert.iconImg ? (
                <img src={cert.iconImg} alt="" class="w-10 h-10 object-contain" />
              ) : (
                <Icon name={cert.icon!} class="w-10 h-10" />
              )}
            </div>
            <div>
              <p class={`font-mono text-sm font-bold ${cert.color}`}>{cert.name}</p>
              <p class="font-mono text-xs text-text-secondary mt-0.5">{cert.fullName}</p>
              <p class="font-mono text-[10px] text-text-muted mt-1">{cert.org} · {cert.date}</p>
            </div>
            <Icon name="lucide:external-link" class="w-3.5 h-3.5 text-text-muted ml-auto opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
        ))}
      </div>
    </div>

    <!-- Timeline -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 300ms;">
      <h2 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-5">
        <span class="text-[#a6e3a1]">#</span> cat /var/log/career.log | tail -6
      </h2>
      <div class="relative">
        <!-- Vertical connector — aligned with center of dots -->
        <div class="absolute left-[15px] top-4 bottom-4 w-px bg-gradient-to-b from-border/50 via-border/30 to-border/50"></div>

        <ul class="space-y-3">
          {timeline.map((item) => (
            <li class="relative pl-11">
              <!-- Type-icon dot -->
              <span class={`absolute left-0 top-3 z-10 flex items-center justify-center w-[31px] h-[31px] rounded-full border ${item.dotBg}`}>
                <Icon name={typeIcon[item.type as keyof typeof typeIcon]} class={`w-3.5 h-3.5 ${item.color}`} />
              </span>

              <!-- Entry card -->
              <div class={`rounded-lg border border-border/40 bg-bg-surface/50 px-4 py-3 transition-all duration-300 ${item.borderHover} hover:bg-bg-surface`}>
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <span class={`font-mono text-[10px] tracking-wider ${item.color}`}>{typeLabel[item.type as keyof typeof typeLabel]}</span>
                  <span class="font-mono text-[10px] text-text-muted">{item.date}</span>
                </div>
                <p class="text-sm mt-1.5 text-text-primary font-medium leading-snug">{item.title}</p>
                {item.subtitle && (
                  <p class="font-mono text-xs text-text-muted mt-1">{item.subtitle}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Current Focus -->
    <div class="mt-10 animate-fade-up" style="animation-delay: 400ms;">
      <h2 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-4">
        <span class="text-[#a6e3a1]">#</span> echo $NEXT_OBJECTIVE
      </h2>
      <div class="rounded-lg border border-[#f9e2af]/20 bg-[#f9e2af]/5 p-5">
        <div class="flex items-center gap-4">
          <img src="/images/certs/cpts.webp" alt="CPTS" class="w-12 h-12 object-contain shrink-0" />
          <div>
            <p class="font-mono text-sm text-[#f9e2af] font-bold">CPTS — Certified Penetration Testing Specialist</p>
            <p class="font-mono text-xs text-text-muted mt-1">Hack The Box · En progreso</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
