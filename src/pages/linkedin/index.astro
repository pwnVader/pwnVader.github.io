---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkedInFeed from '../../components/LinkedInFeed.astro';
import StatsGrid from '../../components/StatsGrid.astro';
import { Icon } from 'astro-icon/components';

const metrics = {
  mainTopics: [
    { name: 'Ciberseguridad' },
    { name: 'Red Team' },
    { name: 'Carrera en Tech' },
    { name: 'IA & Hacking' },
  ],
};
---

<BaseLayout
  title="LinkedIn — pwnVader"
  description="Comunidad y presencia de pwnVader en LinkedIn y TikTok: 28.3K seguidores en TikTok, 2.2K en LinkedIn, posts sobre ciberseguridad, Red Team y carrera en tech."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-20">
    <!-- Page header -->
    <header class="mb-10 animate-fade-up">
      <h1 class="font-mono text-2xl sm:text-3xl font-bold text-text-primary">
        <span class="text-[#a6e3a1]">~/</span>linkedin
      </h1>
      <p class="mt-2 font-mono text-sm text-text-secondary">
        <span class="text-[#a6e3a1]">$</span> curl -s api.linkedin.com/pwnvader | jq '.community'
      </p>
    </header>

    <!-- Community Highlights — LinkedIn Feed (Now first) -->
    <div class="animate-fade-up" style="animation-delay: 100ms;">
      <h2 class="font-mono text-sm text-text-muted mb-5">
        <span class="text-[#a6e3a1]">$</span> cat recent_posts.txt
        <span class="block text-xs mt-1 text-text-muted/70"># Algunos de los posts más relevantes de mi comunidad en línea</span>
      </h2>
      <LinkedInFeed />
    </div>

    <!-- Metrics Cards — Glowing Reactive Dashboard -->
    <div class="mt-14 mb-10 animate-fade-up" style="animation-delay: 200ms;">
      <StatsGrid />
    </div>

    <!-- Topics -->
    <div class="mb-12 animate-fade-up" style="animation-delay: 300ms;">
      <h2 class="font-mono text-sm text-text-muted mb-3">
        <span class="text-[#a6e3a1]">$</span> echo $TOPICS
      </h2>
      <div class="flex flex-wrap gap-2">
        {metrics.mainTopics.map((topic) => (
          <span class="font-mono text-xs px-3 py-1.5 rounded-full border bg-bg-surface border-border text-text-primary">
            {topic.name}
          </span>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center animate-fade-up" style="animation-delay: 700ms;">
      <a
        href="https://linkedin.com/in/perezromerojesus"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg-surface px-6 py-2.5 font-mono text-sm text-text-primary transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name="social-linkedin" class="w-4 h-4 shrink-0 block" />
        Conectar en LinkedIn
      </a>
    </div>
  </section>
</BaseLayout>
