---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const footerLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/pwnvader',
    icon: 'social-github',
    colorClass: 'text-[#cdd6f4]/60',
    hoverClass: 'hover:text-[#cdd6f4]',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/perezromerojesus',
    icon: 'social-linkedin',
    colorClass: 'text-[#74c7ec]/60',
    hoverClass: 'hover:text-[#74c7ec]',
  },
  {
    label: 'TikTok',
    href: 'https://www.tiktok.com/@pwnvader',
    icon: 'social-tiktok',
    colorClass: 'text-[#cdd6f4]/60',
    hoverClass: 'hover:text-[#cdd6f4]',
  },
];
---

<footer class="border-t border-border bg-bg-base mt-auto">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <!-- ASCII divider -->
    <p class="font-mono text-xs text-border text-center mb-6 select-none overflow-hidden whitespace-nowrap">
      ═══════════════════════════════════════════════════════════
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Terminal prompt (softened) -->
      <p class="font-mono text-xs text-text-muted">
        <span class="text-[#a6e3a1]/60">root@pwnvader</span><span class="text-border">:</span><span class="text-[#89b4fa]/60">~</span><span class="text-border">#</span>
        <span class="ml-1">echo "Built with Astro & ☕"</span>
      </p>

      <!-- Social icons — neutral by default, brand color on hover -->
      <div class="flex items-center gap-2">
        {footerLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            title={link.label}
            aria-label={link.label}
            class={`inline-flex items-center justify-center w-7 h-7 rounded transition-colors ${link.colorClass} ${link.hoverClass}`}
          >
            <Icon name={link.icon} class="w-4 h-4 block" />
          </a>
        ))}
      </div>
    </div>

    <!-- Copyright -->
    <p class="font-mono text-[11px] text-text-muted text-center mt-4">
      © {year} pwnVader · Jesus P Romero
    </p>
  </div>
</footer>
