---
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Skills', href: '/skills/' },
  { label: 'Writeups', href: '/writeups/' },
  { label: 'LinkedIn', href: '/linkedin/' },
];

interface ConnectLink {
  label: string;
  href: string;
  icon: string;
  color: string;
  protectedEmail?: { user: string; domain: string; subject?: string };
}

const connectLinks: ConnectLink[] = [
  { label: 'Email', href: '#', icon: 'social-proton', color: 'text-[#b4befe]', protectedEmail: { user: 'contacto', domain: 'pwnvader.com', subject: 'Contacto desde pwnvader.com' } },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/jesuspromero/', icon: 'social-linkedin', color: 'text-[#74c7ec]' },
  { label: 'GitHub', href: 'https://github.com/pwnvader', icon: 'social-github', color: 'text-[#cdd6f4]' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg-base/85 backdrop-blur-md"
  id="main-header"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <!-- Logo -->
    <a href="/" class="group relative font-mono text-lg font-bold text-accent transition-all">
      <span class="relative z-10">pwnVader</span>
      <span
        class="absolute inset-0 text-link opacity-0 group-hover:opacity-100 group-hover:animate-glitch"
        aria-hidden="true"
      >pwnVader</span>
    </a>

    <!-- Desktop nav + Connect -->
    <div class="hidden md:flex items-center gap-1">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'px-3 py-1.5 font-mono text-sm rounded border transition-all',
                isActive(link.href)
                  ? 'text-accent border-accent/30 bg-accent/10'
                  : 'text-text-secondary border-transparent hover:text-text-primary hover:border-border',
              ]}
            >
              {isActive(link.href) ? `> ${link.label}` : link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Connect Button (Desktop) -->
      <div class="relative ml-2" id="connect-wrapper">
        <button
          id="connect-btn"
          class="flex items-center gap-1.5 px-3 py-1.5 font-mono text-sm rounded border border-[#a6e3a1]/30 text-[#a6e3a1] bg-[#a6e3a1]/5 transition-all hover:bg-[#a6e3a1]/10 hover:border-[#a6e3a1]/50 hover:shadow-[0_0_12px_rgba(166,227,161,0.15)]"
          aria-expanded="false"
        >
          <Icon name="lucide:terminal" class="w-3.5 h-3.5" />
          Conectar
          <Icon name="lucide:chevron-down" class="w-3 h-3 transition-transform" id="connect-chevron" />
        </button>

        <!-- Dropdown -->
        <div
          id="connect-dropdown"
          class="absolute right-0 top-full mt-2 w-44 rounded-lg border border-border bg-bg-surface/95 backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.5)] opacity-0 invisible translate-y-1 transition-all duration-200"
        >
          <div class="py-1.5">
            {connectLinks.map((link) => {
              const attrs = link.protectedEmail
                ? {
                    'data-pwn-email': '',
                    'data-pwn-u': link.protectedEmail.user,
                    'data-pwn-d': link.protectedEmail.domain,
                    'data-pwn-subject': link.protectedEmail.subject,
                  }
                : { target: '_blank', rel: 'noopener noreferrer' };
              return (
                <a
                  href={link.href}
                  class="group flex items-center justify-between gap-3 px-4 py-2.5 font-mono text-sm text-text-secondary transition-all hover:text-text-primary hover:bg-bg-elevated/50"
                  {...attrs}
                >
                  <span class="flex items-center gap-2.5">
                    <Icon name={link.icon} class={`w-4 h-4 ${link.color}`} />
                    {link.label}
                  </span>
                  <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 text-text-muted/60 opacity-0 -translate-x-0.5 transition-all group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-text-muted" />
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1 p-2 text-text-secondary hover:text-accent transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-5 h-0.5 bg-current transition-transform origin-center" id="bar1"></span>
      <span class="block w-5 h-0.5 bg-current transition-opacity" id="bar2"></span>
      <span class="block w-5 h-0.5 bg-current transition-transform origin-center" id="bar3"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border bg-bg-base/95 backdrop-blur-md"
  >
    <ul class="flex flex-col px-4 py-3 gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2 font-mono text-sm rounded border transition-all',
              isActive(link.href)
                ? 'text-accent border-accent/30 bg-accent/10'
                : 'text-text-secondary border-transparent hover:text-text-primary hover:border-border',
            ]}
          >
            {isActive(link.href) ? `> ${link.label}` : `  ${link.label}`}
          </a>
        </li>
      ))}
      <!-- Mobile Connect links -->
      <li class="mt-2 pt-2 border-t border-border/50">
        <span class="block px-3 py-1 font-mono text-[10px] text-text-muted uppercase tracking-wider">Conectar</span>
      </li>
      {connectLinks.map((link) => {
        const attrs = link.protectedEmail
          ? {
              'data-pwn-email': '',
              'data-pwn-u': link.protectedEmail.user,
              'data-pwn-d': link.protectedEmail.domain,
              'data-pwn-subject': link.protectedEmail.subject,
            }
          : { target: '_blank', rel: 'noopener noreferrer' };
        return (
          <li>
            <a
              href={link.href}
              class="flex items-center gap-2.5 px-3 py-2 font-mono text-sm text-text-secondary rounded border border-transparent transition-all hover:text-text-primary hover:border-border"
              {...attrs}
            >
              <Icon name={link.icon} class={`w-4 h-4 ${link.color}`} />
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');

    // Close menu on navigation
    menu?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    if (bar1) bar1.style.transform = '';
    if (bar2) bar2.style.opacity = '';
    if (bar3) bar3.style.transform = '';

    btn?.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));

      if (isOpen) {
        bar1!.style.transform = 'rotate(45deg) translate(2px, 2px)';
        bar2!.style.opacity = '0';
        bar3!.style.transform = 'rotate(-45deg) translate(2px, -2px)';
      } else {
        bar1!.style.transform = '';
        bar2!.style.opacity = '';
        bar3!.style.transform = '';
      }
    });

    // Connect dropdown
    const connectBtn = document.getElementById('connect-btn');
    const dropdown = document.getElementById('connect-dropdown');
    const chevron = document.getElementById('connect-chevron');

    connectBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown?.classList.contains('invisible');

      if (isOpen) {
        dropdown?.classList.remove('opacity-0', 'invisible', 'translate-y-1');
        dropdown?.classList.add('opacity-100', 'visible', 'translate-y-0');
        chevron?.style.setProperty('transform', 'rotate(180deg)');
        connectBtn.setAttribute('aria-expanded', 'true');
      } else {
        dropdown?.classList.add('opacity-0', 'invisible', 'translate-y-1');
        dropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
        chevron?.style.setProperty('transform', '');
        connectBtn.setAttribute('aria-expanded', 'false');
      }
    });

    // Close dropdown on click outside
    document.addEventListener('click', () => {
      dropdown?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      dropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      chevron?.style.setProperty('transform', '');
      connectBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
