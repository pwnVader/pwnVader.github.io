---
import { Icon } from 'astro-icon/components';

/**
 * Stat cards.
 *   • Cert cards (COAE, eJPT) — icon shows brand identity at rest (lavender/
 *     magenta from the SVG/image fills); value text and label are neutral.
 *   • Social cards (LinkedIn, TikTok) — currentColor icons stay muted gray
 *     at rest and adopt the brand color only on group-hover.
 *   • Hovering any card lights up the border, value text and the social icon
 *     (cert icons are already at full saturation).
 *
 *   isVector  — icon has hardcoded fills (image or non-currentColor SVG); we
 *               leave it untouched so the brand identity stays visible.
 *   hoverWrap — applied to the wrapper for border + value text + glow on hover.
 *   hoverIcon — applied to currentColor icons so they pick up brand on hover.
 *   href === '' renders a non-interactive <div> (unverified items).
 */
const stats = [
  {
    value: 'COAE',
    label: 'Certificado',
    iconImg: '/images/certs/coae.webp',
    isVector: true,
    hoverWrap: 'hover:border-[#cba6f7] hover:text-[#cba6f7] hover:shadow-[0_0_18px_rgba(203,166,247,0.18)]',
    href: 'https://academy.hackthebox.com/achievement/badge/847979fe-4aca-11f1-82d1-bea50ffe6cb4',
  },
  {
    value: 'eJPTv2',
    label: 'Certificado',
    icon: 'cert-ejpt',
    isVector: true,
    hoverWrap: 'hover:border-[#f5c2e7] hover:text-[#f5c2e7] hover:shadow-[0_0_18px_rgba(245,194,231,0.18)]',
    href: 'https://certs.ine.com/a3d19feb-3d6e-4102-ba75-75e6013bfeee#acc.SaZlAfnt',
  },
  {
    value: '2.3K',
    label: 'LinkedIn',
    icon: 'social-linkedin',
    isVector: false,
    restColor: 'text-[#74c7ec]',
    hoverWrap: 'hover:border-[#74c7ec] hover:text-[#74c7ec] hover:shadow-[0_0_18px_rgba(116,199,236,0.18)]',
    hoverIcon: 'group-hover:text-[#74c7ec]',
    href: 'https://linkedin.com/in/perezromerojesus',
  },
  {
    value: '28.3K',
    label: 'TikTok',
    icon: 'social-tiktok',
    hoverWrap: 'hover:border-[#94e2d5] hover:text-[#94e2d5] hover:shadow-[0_0_18px_rgba(148,226,213,0.15)]',
    hoverIcon: 'group-hover:text-[#94e2d5]',
    href: 'https://www.tiktok.com/@pwnvader',
  },
];

const vectorIconClass = 'w-6 h-6 block transition-all duration-300';
const currentIconClassBase = 'w-6 h-6 block transition-colors duration-300';
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
  {stats.map((stat) => {
    const cardClass = `group rounded-lg border border-border bg-bg-surface p-5 text-center text-text-primary transition-all duration-300 transform hover:-translate-y-1 ${stat.hoverWrap}`;
    const valueClass = 'flex items-center justify-center gap-2 font-mono text-xl sm:text-2xl font-bold transition-colors';
    const labelClass = 'font-mono text-xs text-text-muted mt-2';
    const iconNode = stat.iconImg
      ? <img src={stat.iconImg} alt="" class={`object-contain ${vectorIconClass}`} />
      : stat.icon
        ? <Icon name={stat.icon} class={stat.isVector ? vectorIconClass : `${currentIconClassBase} ${stat.restColor ?? 'text-text-secondary'} ${stat.hoverIcon ?? ''}`} />
        : null;

    return stat.href ? (
      <a href={stat.href} target="_blank" rel="noopener noreferrer" class={cardClass}>
        <p class={valueClass}>
          {iconNode}
          {stat.value}
        </p>
        <p class={labelClass}>{stat.label}</p>
      </a>
    ) : (
      <div class={cardClass}>
        <p class={valueClass}>
          {iconNode}
          {stat.value}
        </p>
        <p class={labelClass}>{stat.label}</p>
      </div>
    );
  })}
</div>
