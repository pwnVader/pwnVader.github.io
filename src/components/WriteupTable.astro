---
import type { WriteupEntry } from '../utils/fetchWriteups';
import { Icon } from 'astro-icon/components';

interface Props {
  writeups: WriteupEntry[];
}

const { writeups } = Astro.props;

/* OS: custom SVG icons + label styling.
   Icons keep their hardcoded SVG colors (Tux for Linux, blue for Windows);
   the pill chrome around them is what we control here. */
const osConfig: Record<string, { icon: string; label: string; class: string }> = {
  Linux:   { icon: 'os-linux',          label: 'Linux',   class: 'text-text-secondary border-border/50 bg-bg-elevated' },
  Windows: { icon: 'os-windows',        label: 'Windows', class: 'text-text-secondary border-border/50 bg-bg-elevated' },
  Other:   { icon: 'lucide:help-circle', label: 'Other',  class: 'text-text-muted border-border bg-transparent' },
  'N/A':   { icon: 'lucide:minus',       label: 'N/A',    class: 'text-text-muted border-border bg-transparent' },
};

/* Difficulty: subtle colors within the curated palette */
const diffConfig: Record<string, { class: string }> = {
  Easy:   { class: 'text-text-secondary border-border bg-bg-elevated/40' },
  Medium: { class: 'text-text-secondary border-border bg-bg-elevated/40' },
  Hard:   { class: 'text-slate-400 border-slate-500/30 bg-slate-500/10' },
  Insane: { class: 'text-slate-400 border-slate-500/30 bg-slate-500/10' },
  'N/A':  { class: 'text-text-muted border-border bg-transparent' },
};

/* Platform: HTB green, TryHackMe red — matching the cards above */
const platformConfig: Record<string, { icon: string; label: string; class: string }> = {
  HackTheBox: { icon: 'tech-htb',   label: 'HTB', class: 'text-text-secondary border-border bg-bg-elevated/40' },
  TryHackMe:  { icon: 'social-thm', label: 'THM', class: 'text-text-secondary border-border bg-bg-elevated/40' },
  'N/A':      { icon: 'lucide:flag',label: 'N/A', class: 'text-text-muted border-border bg-transparent' },
};
---

<div class="writeup-table">
  <!-- Table container -->
  <div class="bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 relative">
    <!-- Column headers -->
    <!-- Column headers -->
    <div class="hidden sm:grid grid-cols-[100px_minmax(0,1.4fr)_minmax(0,1fr)_120px_90px] gap-0 font-mono text-[11px] text-text-muted border-b border-slate-800/50 bg-transparent uppercase tracking-wider">
      <span class="px-3 py-2.5">Platform</span>
      <span class="px-3 py-2.5">Máquina</span>
      <span class="px-3 py-2.5">Tags</span>
      <span class="px-3 py-2.5 text-center">OS</span>
      <span class="px-3 py-2.5 text-center">Diff</span>
    </div>

    <!-- Rows -->
    {writeups.length > 0 ? (
      <div class="divide-y divide-slate-800/50">
        {writeups.map((entry, i) => (
          <a
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-1 sm:grid-cols-[100px_minmax(0,1.4fr)_minmax(0,1fr)_120px_90px] gap-0 items-center transition-all duration-150 hover:bg-slate-500/10 border-l-[3px] border-transparent hover:border-slate-500 animate-fade-up"
            style={`animation-delay: ${i * 30}ms;`}
          >
            {/* Platform */}
            <span class="hidden sm:flex items-center px-3 py-3">
              <span class:list={[
                'inline-flex items-center gap-1.5 font-mono text-xs px-2 py-0.5 rounded border',
                (platformConfig[entry.platform] || platformConfig['N/A']).class
              ]}>
                <Icon name={(platformConfig[entry.platform] || platformConfig['N/A']).icon} class="w-3.5 h-3.5" />
                {(platformConfig[entry.platform] || platformConfig['N/A']).label}
              </span>
            </span>

            {/* Title */}
            <span class="px-4 sm:px-3 py-3 font-mono text-sm text-text-primary group-hover:text-slate-400 transition-colors">
              {entry.title}
              <span class="text-text-muted text-xs ml-1.5">↗</span>
            </span>

            {/* Tags */}
            <span class="hidden sm:flex flex-wrap items-center gap-1 px-3 py-3">
              {entry.tags.length > 0 ? (
                entry.tags.slice(0, 2).map((tag) => (
                  <span class="font-mono text-[10px] px-1.5 py-0.5 rounded border border-border/60 bg-bg-elevated/40 text-text-muted">
                    {tag}
                  </span>
                ))
              ) : (
                <span class="font-mono text-[10px] text-text-muted/60">—</span>
              )}
            </span>

            {/* OS — icon only, label exposed for screen readers */}
            <span class="hidden sm:flex justify-center py-3">
              <span
                title={(osConfig[entry.os] || osConfig['N/A']).label}
                aria-label={(osConfig[entry.os] || osConfig['N/A']).label}
                class:list={[
                  'inline-flex items-center justify-center font-mono text-xs px-2 py-0.5 rounded border',
                  (osConfig[entry.os] || osConfig['N/A']).class,
                ]}
              >
                <Icon
                  name={(osConfig[entry.os] || osConfig['N/A']).icon}
                  class="w-4 h-4"
                />
              </span>
            </span>

            {/* Difficulty — subtle colored pill */}
            <span class="hidden sm:flex justify-center py-3">
              <span class:list={[
                'font-mono text-xs px-2 py-0.5 rounded border',
                (diffConfig[entry.difficulty] || diffConfig['N/A']).class,
              ]}>
                {entry.difficulty}
              </span>
            </span>

            {/* Mobile metadata */}
            <div class="flex flex-wrap items-center gap-2 px-4 pb-3 sm:hidden font-mono text-xs">
              <span class:list={[
                'inline-flex items-center gap-1.5',
                (platformConfig[entry.platform] || platformConfig['N/A']).class.split(' ')[0]
              ]}>
                <Icon name={(platformConfig[entry.platform] || platformConfig['N/A']).icon} class="w-4 h-4" />
                {entry.platform}
              </span>
              <span class="text-border">·</span>
              <span class:list={[
                'px-1.5 py-0.5 rounded border',
                (diffConfig[entry.difficulty] || diffConfig['N/A']).class,
              ]}>
                {entry.difficulty}
              </span>
              <span class="text-border">·</span>
              <span
                title={(osConfig[entry.os] || osConfig['N/A']).label}
                aria-label={(osConfig[entry.os] || osConfig['N/A']).label}
                class:list={[
                  'inline-flex items-center justify-center px-1.5 py-0.5 rounded border',
                  (osConfig[entry.os] || osConfig['N/A']).class,
                ]}
              >
                <Icon name={(osConfig[entry.os] || osConfig['N/A']).icon} class="w-3 h-3" />
              </span>
              {entry.tags.length > 0 && (
                <>
                  <span class="text-border">·</span>
                  <span class="flex flex-wrap items-center gap-1">
                    {entry.tags.slice(0, 2).map((tag) => (
                      <span class="font-mono text-[10px] px-1.5 py-0.5 rounded border border-border/60 bg-bg-elevated/40 text-text-muted">
                        {tag}
                      </span>
                    ))}
                  </span>
                </>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="px-4 py-8 text-center font-mono text-sm text-text-muted">
        <p>No writeups found.</p>
        <p class="mt-1 text-xs text-text-muted/60">
          <span class="text-slate-400/60">$</span> echo "Check back soon..."
        </p>
      </div>
    )}
  </div>

  <!-- Footer status -->
  <div class="mt-3 font-mono text-[11px] text-text-muted/60 flex items-center justify-between px-1">
    <span>
      <span class="text-slate-400/40">$</span> total: {writeups.length} file(s)
    </span>
    <span>
      source: github.com/{`${Astro.props.writeups.length > 0 ? 'pwnVader/CybersecurityDocs' : 'static fallback'}`}
    </span>
  </div>
</div>
