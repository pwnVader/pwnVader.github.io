---
/**
 * Fastfetch-style social showcase.
 *
 * Left: Kali ASCII (desktop only — hidden on mobile to keep layout tight).
 * Right: socials rendered as `key: value · badge` rows, fastfetch info-style.
 * Collapsible via header button; state persisted in localStorage.
 *
 * Kali ASCII sourced from fastfetch-cli/fastfetch (src/logo/ascii/kali.txt),
 * `$1` / `$2` color tokens stripped — we render one Kali-blue color.
 */

const kaliAscii = `..............
            ..,;:ccc,.
          ......''';lxO.
.....''''..........,:ld;
           .';;;:::;,,.x,
      ..'''.            0Xxoc:,.  ...
  ....                ,ONkc;,;cokOdc',.
 .                   OMo           ':ddo.
                    dMc               :OO;
                    0M.                 .:o.
                    ;Wd
                     ;XO,
                       ,d0Odlc;,..
                           ..',;:cdOOd::,.
                                    .:d;.':;.
                                       'd,  .'
                                         ;l   ..
                                          .o
                                            c
                                            .'
                                             .`;

interface SocialRow {
  key: string;
  value: string;
  badge?: string;
  href: string;
  keyColor?: string;
}

const socials: SocialRow[] = [
  { key: 'Lab',        value: 'hacking.pwnvader.com', badge: 'tools',                  href: 'https://hacking.pwnvader.com' },
  { key: 'Docs',       value: 'docs.pwnvader.com',    badge: 'writeups + methodologies', href: 'https://docs.pwnvader.com' },
  { key: 'LinkedIn',   value: 'jesuspromero',         badge: '2.3K',   href: 'https://www.linkedin.com/in/jesuspromero/' },
  { key: 'TikTok',     value: '@pwnvader',            badge: '28.3K',  href: 'https://www.tiktok.com/@pwnvader' },
  { key: 'GitHub',     value: 'pwnvader',                              href: 'https://github.com/pwnvader' },
  { key: 'Medium',     value: '@pwnvader',                             href: 'https://medium.com/@pwnvader' },
  { key: 'TryHackMe',  value: 'pwnVader',             badge: 'Top 1%', href: 'https://tryhackme.com/p/pwnVader' },
  { key: 'HackTheBox', value: 'pwnVader',                              href: 'https://app.hackthebox.com/users/1247070' },
  { key: 'Email',      value: 'contacto@pwnvader.com',                 href: 'mailto:contacto@pwnvader.com' },
];

// `ch` width — align the colons. +2 = colon + breathing space.
const keyColCh = Math.max(...socials.map(s => s.key.length)) + 2;
const separatorWidth = 32;
---

<div id="social-fastfetch" class="relative mt-8">
  <!-- Prompt (Outside the box, top left) -->
  <div class="font-mono text-sm leading-tight text-slate-400 mb-2 -ml-2 sm:-ml-4">
    <div>┌─(<span class="text-slate-400 font-bold">pwnvader㉿kali</span>)-[<span class="text-slate-400">~</span>]</div>
    <div>└─<span class="text-slate-400 font-bold">$</span> <span class="text-slate-300">fastfetch</span></div>
  </div>

  <!-- Body -->
  <div id="fastfetch-body" class="bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 p-4 sm:p-6 font-mono text-xs sm:text-sm leading-relaxed text-slate-300">
    <div class="flex flex-col md:flex-row md:items-start gap-6 md:gap-8">
      <!-- Kali ASCII — desktop only -->
      <pre
        class="hidden md:block text-slate-700 text-[13px] leading-[1.15] select-none shrink-0"
        aria-hidden="true"
      >{kaliAscii}</pre>

      <!-- Info column -->
      <div class="flex-1 min-w-0 space-y-1">
        <p class="text-base text-slate-400 font-bold mb-1">root@pwnvader</p>
        <p class="text-slate-700 select-none leading-none mb-3">{'-'.repeat(separatorWidth)}</p>

        <div class="space-y-0.5 pt-1">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('mailto') ? undefined : '_blank'}
              rel={s.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              class="group flex items-baseline gap-1 sm:gap-2 rounded px-1.5 -mx-1.5 py-0.5 transition-all duration-200 hover:bg-bg-elevated/40 hover:-translate-y-0.5 transform"
            >
              <span
                class="font-bold shrink-0 text-slate-400"
                style={`min-width: ${keyColCh}ch;`}
              >{s.key}:</span>
              <span class="text-slate-300 group-hover:text-white transition-colors truncate">
                {s.value}
                {s.badge && <span class="text-slate-500 ml-1.5 sm:ml-2">· {s.badge}</span>}
              </span>
            </a>
          ))}
        </div>

        <!-- Color palette row (Sky/Slate) -->
        <div class="flex gap-1 pt-4" aria-hidden="true">
          <span class="w-4 h-2.5 bg-slate-900 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-slate-700 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-slate-500 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-cyan-900 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-cyan-700 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-cyan-500 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-cyan-300 rounded-sm"></span>
          <span class="w-4 h-2.5 bg-slate-100 rounded-sm"></span>
        </div>

      </div>
    </div>
  </div>
</div>

