---
import { socialLinks } from '../data/social-links';
import { Icon } from 'astro-icon/components';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <div class="flex flex-wrap gap-3">
    {socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        title={`${link.label} — ${link.handle}`}
        class="flex items-center justify-center w-10 h-10 bg-transparent border-t border-slate-800/50 hover:bg-slate-800/40 text-slate-100 transition-all duration-300 hover:border-sky-500 hover:text-sky-500 hover:shadow-[0_0_12px_rgba(14,165,233,0.2)]"
      >
        <Icon name={link.icon} class="w-5 h-5" />
      </a>
    ))}
  </div>
) : (
  <div class="grid gap-2.5 sm:grid-cols-2">
    {socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1 sm:gap-4 bg-slate-900/30 backdrop-blur-sm rounded-lg border border-slate-800/50 px-4 py-3 transition-all duration-300 hover:bg-slate-800/40 hover:border-slate-600/60 overflow-hidden transform hover:-translate-y-1 hover:-translate-x-1"
      >
        <span class="flex items-center gap-2.5 whitespace-nowrap shrink-0">
          <Icon name={link.icon} class="w-4 h-4 text-slate-100 transition-colors" />
          <span class="font-mono text-sm font-medium text-text-primary transition-colors group-hover:text-slate-200">{link.label}</span>
        </span>
        <span class="font-mono text-xs text-text-muted truncate w-full sm:w-auto text-left sm:text-right group-hover:text-slate-400 transition-colors">{link.handle} ↗</span>
      </a>
    ))}
  </div>
)}
