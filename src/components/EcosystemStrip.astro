---
const links = [
  { href: 'https://pwnvader.com',         label: 'portfolio', current: true  },
  { href: 'https://hacking.pwnvader.com', label: 'lab',       current: false },
  { href: 'https://docs.pwnvader.com',    label: 'docs',      current: false },
];
---
<div class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-black/40 backdrop-blur-md text-[10px] font-mono uppercase tracking-[0.18em] h-7 select-none">
  <div class="mx-auto max-w-5xl px-4 py-1.5 flex items-center justify-between gap-4 h-full">
    <div class="flex items-center gap-4 text-zinc-500">
      <span class="hidden sm:inline">ecosystem</span>
      <span class="text-zinc-700 hidden sm:inline">·</span>
      {links.map(l => l.current ? (
        <span class="text-orange-400 border-b border-orange-400 pb-0.5 -mb-0.5 font-bold">{l.label}</span>
      ) : (
        <a href={l.href} target="_blank" rel="noopener noreferrer"
           class="hover:text-orange-400 transition-colors">{l.label}</a>
      ))}
    </div>
    <span class="hidden md:inline text-zinc-700">pwnVader · v1</span>
  </div>
</div>
