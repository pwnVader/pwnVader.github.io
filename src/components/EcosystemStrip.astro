---
const links = [
  { href: 'https://pwnvader.com',         label: 'portfolio', current: true  },
  { href: 'https://hacking.pwnvader.com', label: 'lab',       current: false },
  { href: 'https://docs.pwnvader.com',    label: 'docs',      current: false },
];
---
<div class="border-b border-white/10 bg-black/40 backdrop-blur-md text-[10px] font-mono uppercase tracking-[0.18em] select-none">
  <div class="mx-auto max-w-5xl px-4 py-1.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 text-text-muted">
      <span class="hidden sm:inline">ecosystem</span>
      <span class="text-text-secondary hidden sm:inline">·</span>
      {links.map(l => l.current ? (
        <span class="text-sky-500 border-b border-sky-500 pb-0.5 -mb-0.5 font-bold">{l.label}</span>
      ) : (
        <a href={l.href} target="_blank" rel="noopener noreferrer"
           class="hover:text-sky-500 transition-colors">{l.label}</a>
      ))}
    </div>
    <span class="hidden md:inline text-text-secondary">pwnVader · v1</span>
  </div>
</div>
