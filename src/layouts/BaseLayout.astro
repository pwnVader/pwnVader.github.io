---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Used for og:title and twitter:title (the per-page rich title shown on social shares + Google). */
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Portafolio profesional de Jesus P Romero (pwnVader) — Pentester, COAE, eJPTv2. Seguridad ofensiva, IA Red Team, writeups y comunidad.',
  ogImage = '/images/og-default.png',
} = Astro.props;

/** Constant browser-tab / window title — keeps a unified brand across the site. */
const TAB_TITLE = 'Portfolio pwnVader';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullOgImage = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{TAB_TITLE}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="Jesus P Romero (pwnVader)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph — keeps per-page title for social shares -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Fonts: self-hosted via @fontsource (zero external tracking) -->

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="scanlines scan-beam flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 pt-14">
      <slot />
    </main>
    <Footer />

    <!--
      Email obfuscation. With JS disabled (Mullvad strict, Tor, scrapers/bots),
      visible address stays as `[email protected]` and the href stays as `#`.
      JS-enabled clients get the real address restored client-side.
      Mirrors Cloudflare Scrape Shield behavior at the source so it works even
      when CF caches a non-obfuscated response.
    -->
    <script>
      function revealProtectedEmails() {
        document.querySelectorAll<HTMLAnchorElement>('a[data-pwn-email]').forEach((el) => {
          const u = el.dataset.pwnU;
          const d = el.dataset.pwnD;
          if (!u || !d) return;
          const email = `${u}@${d}`;
          const subject = el.dataset.pwnSubject;
          el.href = subject
            ? `mailto:${email}?subject=${encodeURIComponent(subject)}`
            : `mailto:${email}`;
          const text = el.querySelector<HTMLElement>('[data-pwn-email-text]');
          if (text) text.textContent = email;
        });
      }
      document.addEventListener('astro:page-load', revealProtectedEmails);
    </script>
  </body>
</html>
